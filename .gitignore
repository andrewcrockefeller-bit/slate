# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode
#
# The project is generated from project.yml by XcodeGen and is therefore not
# committed. Run `xcodegen generate` after cloning, or after adding a file.
*.xcodeproj
*.xcuserstate
xcuserdata/
DerivedData/
*.xcscmblueprint
*.xccheckout
build/

# XcodeGen built from source when Homebrew is not available.
# Tools/xcodegen-version.txt IS committed — it pins the generator commit.
Tools/.xcodegen-src/
